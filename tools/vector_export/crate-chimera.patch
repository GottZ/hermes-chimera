diff --git b/src/chimera_ext/human_voice_ext.rs b/src/chimera_ext/human_voice_ext.rs
new file mode 100644
index 0000000..4dc135b
--- /dev/null
+++ b/src/chimera_ext/human_voice_ext.rs
@@ -0,0 +1,295 @@
+//! chimera export: control-step recorder for `voice::human_voice` (child module).
+//!
+//! `control()` calls four hooks (pre: before `airway.apply`, mid: after it, post: after the
+//! optional contact re-apply, end: as the last statement of `control()`). The row of a block is
+//! taken in `end`, i.e. after the complete control step (breath gate, lung pressure, effort and
+//! the f0 glide are set after the re-apply, human_voice.rs:477-501), which is the state the
+//! samples of the block run with: `render()` calls nothing else between `control()` and the
+//! block's first sample (human_voice.rs:356-366). With no recorder started the hooks return at
+//! once and change nothing. In `Mode::Record` they only read. The two self-check modes overwrite
+//! the filter states of the final noise list after the block's `set_noise_sources` calls (in
+//! `post`; nothing after it touches the noise list or its states):
+//!   - `EmulateInherit`: states := saved states of the previous block's final list at index
+//!     `noise_inherit[j]` (0 for -1) -- what a port kernel does with the recorded track;
+//!   - `P1Rebase`: the REVIEW-1 P1 emulation "final list against the previous block"
+//!     (`p1_rebase_noise_states`, only on blocks with a contact re-apply, as in the REVIEW-1 P1 probe).
+use super::HumanVoice;
+use crate::airway::network::NoiseSource;
+use crate::airway::network::chimera_ext::NoiseFull;
+use crate::sources::glottis::GlottisParams;
+use serde_json::{Value, json};
+use std::cell::RefCell;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Mode {
+    Record,
+    EmulateInherit,
+    P1Rebase,
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct NoiseRow {
+    pub src: usize,
+    pub fwd: usize,
+    pub bwd: usize,
+    pub gain: f64,
+    pub lowpass_hz: f64,
+    pub highpass_hz: f64,
+    pub lp_coef: f64,
+    pub hp_coef: f64,
+}
+
+#[derive(Clone, Debug, Default)]
+pub struct Row {
+    pub ph_areas: Vec<f64>,
+    pub or_areas: Vec<f64>,
+    pub ph_min: Vec<f64>,
+    pub or_min: Vec<f64>,
+    pub ph_len: f64,
+    pub or_len: f64,
+    /// frame.velum_port of the final geometry of the step
+    pub velum: f64,
+    /// net.port_area_target[velum_port] (= js_max(0, velum))
+    pub velum_target: f64,
+    /// final noise list of the step
+    pub noise: Vec<NoiseRow>,
+    pub glot: [f64; 17],
+    pub p_lung: f64,
+    /// lung pressure applied so far (kernel state at the block start) and the per-sample ramp step
+    pub p_lung_now: f64,
+    pub p_lung_step: f64,
+    pub reapply: bool,
+    /// intermediate list A (after `apply`, before the contact re-apply); empty when no re-apply
+    pub list_a: Vec<NoiseRow>,
+    pub inherit: Vec<i64>,
+    /// "final list against the previous block": first (src,fwd) match in the previous final list
+    pub inherit_p1: Vec<i64>,
+    /// record mode: sources whose actual (hp, lp1, lp2) differ bitwise from what `inherit` predicts
+    pub inherit_check_failures: u32,
+    /// lp_coef/hp_coef differing bitwise from 1-exp(-2*PI*lowpass/fs) / exp(-2*PI*highpass/fs)
+    pub coef_check_failures: u32,
+    pub clock: f64,
+    pub gate: f64,
+    pub f0_glide: f64,
+    pub artic_x: [f64; 17],
+    pub artic_v: [f64; 17],
+    pub contact_tip: f64,
+    pub contact_body: f64,
+}
+
+pub struct Recorder {
+    pub mode: Mode,
+    pub rows: Vec<Row>,
+    /// noise bookkeeping of the running control step, completed by `chimera_hook_end`
+    pending: Option<Row>,
+}
+
+thread_local! {
+    static REC: RefCell<Option<Recorder>> = const { RefCell::new(None) };
+}
+
+pub fn start(mode: Mode) {
+    REC.with(|r| *r.borrow_mut() = Some(Recorder { mode, rows: Vec::new(), pending: None }));
+}
+
+pub fn take() -> Option<Recorder> {
+    REC.with(|r| r.borrow_mut().take())
+}
+
+fn active() -> Option<Mode> {
+    REC.with(|r| r.borrow().as_ref().map(|x| x.mode))
+}
+
+pub struct Pre {
+    full: Vec<NoiseFull>,
+    raw: Vec<NoiseSource>,
+}
+
+pub fn glottis_array(g: &GlottisParams) -> [f64; 17] {
+    [g.f0, g.amplitude, g.abduction, g.chink, g.open_quotient, g.skew, g.closure_sharpness, g.effort, g.jitter, g.shimmer, g.vibrato_depth, g.vibrato_rate, g.drift, g.fry, g.diplophonia, g.closure, g.chaos]
+}
+
+fn find(list: &[(usize, usize)], src: usize, fwd: usize) -> Option<usize> {
+    list.iter().position(|o| o.0 == src && o.1 == fwd)
+}
+
+impl HumanVoice {
+    pub(crate) fn chimera_hook_pre(&self) -> Option<Pre> {
+        active().map(|_| Pre { full: self.airway.net.chimera_noise_full(), raw: self.airway.net.noise_sources().to_vec() })
+    }
+
+    pub(crate) fn chimera_hook_mid(&self) -> Option<Vec<NoiseRow>> {
+        active().map(|_| self.chimera_noise_rows())
+    }
+
+    pub(crate) fn chimera_hook_post(&mut self, pre: Option<Pre>, mid: Option<Vec<NoiseRow>>, reapplied: bool) {
+        let Some(mode) = active() else { return };
+        let pre = pre.expect("pre snapshot");
+        let a = mid.expect("mid snapshot");
+        let b = self.chimera_noise_rows();
+        let p_pairs: Vec<(usize, usize)> = pre.full.iter().map(|s| (s.src, s.fwd)).collect();
+        let a_pairs: Vec<(usize, usize)> = a.iter().map(|s| (s.src, s.fwd)).collect();
+        let to_i = |o: Option<usize>| o.map_or(-1i64, |k| k as i64);
+        // composition of both set_noise_sources calls: B[j] <- A[find(A, B[j])] <- P[find(P, A[i])]
+        let inherit: Vec<i64> = b
+            .iter()
+            .map(|s| {
+                if reapplied {
+                    match find(&a_pairs, s.src, s.fwd) {
+                        None => -1,
+                        Some(i) => to_i(find(&p_pairs, a[i].src, a[i].fwd)),
+                    }
+                } else {
+                    to_i(find(&p_pairs, s.src, s.fwd))
+                }
+            })
+            .collect();
+        let inherit_p1: Vec<i64> = b.iter().map(|s| to_i(find(&p_pairs, s.src, s.fwd))).collect();
+        let predicted: Vec<[f64; 3]> = inherit
+            .iter()
+            .map(|&k| if k >= 0 { let p = &pre.full[k as usize]; [p.hp, p.lp1, p.lp2] } else { [0.0; 3] })
+            .collect();
+        let mut failures = 0u32;
+        match mode {
+            Mode::Record => {
+                let now = self.airway.net.chimera_noise_full();
+                for (s, p) in now.iter().zip(&predicted) {
+                    if s.hp.to_bits() != p[0].to_bits() || s.lp1.to_bits() != p[1].to_bits() || s.lp2.to_bits() != p[2].to_bits() {
+                        failures += 1;
+                    }
+                }
+            }
+            Mode::EmulateInherit => self.airway.net.chimera_set_noise_states(&predicted),
+            Mode::P1Rebase => {
+                if reapplied {
+                    self.airway.net.p1_rebase_noise_states(&pre.raw);
+                }
+            }
+        }
+        let row = Row { reapply: reapplied, list_a: if reapplied { a } else { Vec::new() }, inherit, inherit_p1, inherit_check_failures: failures, ..Row::default() };
+        REC.with(|r| {
+            let mut r = r.borrow_mut();
+            let r = r.as_mut().unwrap();
+            assert!(r.pending.is_none(), "control step without end hook");
+            r.pending = Some(row);
+        });
+    }
+
+    /// Last statement of `control()`: the row of this block = state after the complete step.
+    pub(crate) fn chimera_hook_end(&self) {
+        if active().is_none() {
+            return;
+        }
+        let p = REC.with(|r| r.borrow_mut().as_mut().unwrap().pending.take()).expect("end hook without post hook");
+        let mut row = self.chimera_snapshot();
+        row.reapply = p.reapply;
+        row.list_a = p.list_a;
+        row.inherit = p.inherit;
+        row.inherit_p1 = p.inherit_p1;
+        row.inherit_check_failures = p.inherit_check_failures;
+        REC.with(|r| r.borrow_mut().as_mut().unwrap().rows.push(row));
+    }
+
+    fn chimera_noise_rows(&self) -> Vec<NoiseRow> {
+        let full = self.airway.net.chimera_noise_full();
+        let specs = self.airway.chimera_noise_specs();
+        assert_eq!(full.len(), specs.len(), "noise list and spec list differ in length");
+        full.iter()
+            .zip(specs)
+            .map(|(s, p)| {
+                assert!(s.src == p.src && s.fwd == p.fwd && s.bwd == p.bwd);
+                NoiseRow { src: s.src, fwd: s.fwd, bwd: s.bwd, gain: s.gain, lowpass_hz: p.lowpass_hz, highpass_hz: p.highpass_hz, lp_coef: s.lp_coef, hp_coef: s.hp_coef }
+            })
+            .collect()
+    }
+
+    /// The control outputs as they stand now (after the constructor, or after a control step).
+    pub fn chimera_snapshot(&self) -> Row {
+        use crate::math::{PI, exp};
+        let aw = &self.airway;
+        let noise = self.chimera_noise_rows();
+        let fs = aw.net.fs;
+        let coef_fail = noise
+            .iter()
+            .filter(|s| s.lp_coef.to_bits() != (1.0 - exp((-2.0 * PI * s.lowpass_hz) / fs)).to_bits() || s.hp_coef.to_bits() != exp((-2.0 * PI * s.highpass_hz) / fs).to_bits())
+            .count() as u32;
+        Row {
+            ph_areas: aw.ph_areas.clone(),
+            or_areas: aw.or_areas.clone(),
+            ph_min: aw.ph_min.clone(),
+            or_min: aw.or_min.clone(),
+            ph_len: aw.ph_len,
+            or_len: aw.or_len,
+            velum: aw.frame.as_ref().map_or(f64::NAN, |f| f.velum_port),
+            velum_target: aw.net.chimera_port_area_target(aw.velum_port),
+            noise,
+            glot: glottis_array(&self.glottis.params),
+            p_lung: self.p_lung,
+            p_lung_now: self.p_lung_now,
+            p_lung_step: self.p_lung_step,
+            reapply: false,
+            list_a: Vec::new(),
+            inherit: Vec::new(),
+            inherit_p1: Vec::new(),
+            inherit_check_failures: 0,
+            coef_check_failures: coef_fail,
+            clock: self.clock,
+            gate: self.gate,
+            f0_glide: self.f0,
+            artic_x: self.artic.x.to_array(),
+            artic_v: self.artic.v,
+            contact_tip: aw.tract.contact_tip,
+            contact_body: aw.tract.contact_body,
+        }
+    }
+
+    /// Which GlottisParams fields `apply_source()` writes: run it on a clone whose params are all a
+    /// sentinel value and report the fields that changed (G_* order).
+    pub fn chimera_apply_source_mask(&self) -> [bool; 17] {
+        let mut v = self.clone();
+        let s = -12345.678_f64;
+        v.glottis.params = GlottisParams { f0: s, amplitude: s, abduction: s, chink: s, open_quotient: s, skew: s, closure_sharpness: s, effort: s, jitter: s, shimmer: s, vibrato_depth: s, vibrato_rate: s, drift: s, fry: s, diplophonia: s, closure: s, chaos: s };
+        v.apply_source();
+        glottis_array(&v.glottis.params).map(|x| x.to_bits() != s.to_bits())
+    }
+
+    /// Private voice-level state (initial-state export).
+    pub fn chimera_private(&self) -> Value {
+        let (blen, bpos, bcount) = self.dec.chimera_pos();
+        json!({
+            "fs_out": self.fs_out,
+            "m": self.m,
+            "fs": self.fs,
+            "ctrl_every": self.ctrl_every,
+            "ctrl_counter": self.ctrl_counter,
+            "gate": self.gate,
+            "gate_target": self.gate_target,
+            "score_breath_hold": self.score_breath_hold,
+            "p_lung": self.p_lung,
+            "p_lung_now": self.p_lung_now,
+            "p_lung_step": self.p_lung_step,
+            "f0_glide": self.f0,
+            "output_gain": self.output_gain,
+            "dc_x": self.dc_x,
+            "dc_y": self.dc_y,
+            "dc_coef": self.dc_coef,
+            "clock": self.clock,
+            "base_abduction": self.base_abduction,
+            "base_closure": self.base_closure,
+            "score_f0": self.score_f0,
+            "lim_env": self.lim_env,
+            "lim_hold": self.lim_hold,
+            "lim_hold_n": self.lim_hold_n,
+            "lim_release": self.lim_release,
+            "max_penetration": self.max_penetration,
+            "decimator": { "factor": self.dec.factor, "coeffs": self.dec.chimera_coeffs(), "buf_len": blen, "pos": bpos, "count": bcount, "value": self.dec.value },
+            "glottis_params": glottis_array(&self.glottis.params),
+            "glottis_state": self.glottis.chimera_state(),
+            "artic_x": self.artic.x.to_array(),
+            "artic_v": self.artic.v,
+            "artic_target": self.artic.target.to_array(),
+            "tip_free": self.artic.tip_free,
+            "max_area_rate": self.airway.max_area_rate,
+        })
+    }
+}
