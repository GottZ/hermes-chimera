diff --git b/src/chimera_ext/network_ext.rs b/src/chimera_ext/network_ext.rs
new file mode 100644
index 0000000..7d0555e
--- /dev/null
+++ b/src/chimera_ext/network_ext.rs
@@ -0,0 +1,157 @@
+//! chimera export: accessors for `airway::network` (child module).
+//! Everything here reads, except `chimera_set_noise_states` and `p1_rebase_noise_states`, which are
+//! called only by the self-check modes of the recorder (never in record mode).
+use super::{AirwayNetwork, Area, KIND_PORT, NoiseSource};
+use serde_json::{Value, json};
+
+/// One noise source with its private filter state: (src, fwd, bwd) and
+/// (gain, hp, lp1, lp2, lp_coef, hp_coef, level).
+#[derive(Clone, Copy, Debug)]
+pub struct NoiseFull {
+    pub src: usize,
+    pub fwd: usize,
+    pub bwd: usize,
+    pub gain: f64,
+    pub hp: f64,
+    pub lp1: f64,
+    pub lp2: f64,
+    pub lp_coef: f64,
+    pub hp_coef: f64,
+    pub level: f64,
+}
+
+impl AirwayNetwork {
+    pub fn chimera_noise_full(&self) -> Vec<NoiseFull> {
+        self.noise
+            .iter()
+            .map(|s| NoiseFull { src: s.src, fwd: s.fwd, bwd: s.bwd, gain: s.gain, hp: s.hp, lp1: s.lp1, lp2: s.lp2, lp_coef: s.lp_coef, hp_coef: s.hp_coef, level: s.level })
+            .collect()
+    }
+
+    /// Self-check only: overwrite the filter states (hp, lp1, lp2) of the current list.
+    pub fn chimera_set_noise_states(&mut self, states: &[[f64; 3]]) {
+        assert_eq!(states.len(), self.noise.len());
+        for (s, st) in self.noise.iter_mut().zip(states) {
+            s.hp = st[0];
+            s.lp1 = st[1];
+            s.lp2 = st[2];
+        }
+    }
+
+    /// Self-check only (verbatim from the REVIEW-1 P1 probe): re-derive the filter states of the
+    /// current sources from `prev` (first (src,fwd) match), i.e. as if only the final list had been
+    /// applied against the previous block's list.
+    pub fn p1_rebase_noise_states(&mut self, prev: &[NoiseSource]) {
+        for s in self.noise.iter_mut() {
+            let p = prev.iter().find(|o| o.src == s.src && o.fwd == s.fwd);
+            s.hp = p.map_or(0.0, |p| p.hp);
+            s.lp1 = p.map_or(0.0, |p| p.lp1);
+            s.lp2 = p.map_or(0.0, |p| p.lp2);
+        }
+    }
+
+    pub fn chimera_rng_state(&self) -> u32 {
+        self.rng.chimera_state()
+    }
+
+    pub fn chimera_port_area_target(&self, branch: usize) -> f64 {
+        self.port_area_target[branch]
+    }
+
+    /// Private structure and state of the network (everything `step()` reads besides the public
+    /// fields), for the topology vector.
+    pub fn chimera_topology(&self) -> Value {
+        let tube_specs: Vec<Value> = self
+            .tube_specs
+            .iter()
+            .map(|s| {
+                let area = match &s.area {
+                    Area::Uniform(a) => json!({ "uniform": a }),
+                    Area::Profile(v) => json!({ "profile": v }),
+                };
+                json!({
+                    "name": s.name,
+                    "n": s.n,
+                    "length": s.length,
+                    "area": area,
+                    "wall": s.wall.map(|w| [w.mass, w.resistance, w.stiffness]),
+                    "perimeter_factor": s.perimeter_factor,
+                    "viscous_factor": s.viscous_factor,
+                    "wall_radiation": s.wall_radiation,
+                })
+            })
+            .collect();
+        let ports: Vec<Value> = (0..self.n_branches)
+            .filter(|&j| self.b_kind[j] == KIND_PORT)
+            .map(|j| {
+                json!({
+                    "branch": j,
+                    "spec_area": self.port_specs[j].map(|s| s.area),
+                    "length": self.port_len[j],
+                    "k_entrance": self.port_kin[j],
+                    "k_exit": self.port_kex[j],
+                    "slit_width": self.port_slit[j],
+                    "half_sections": self.port_half[j],
+                    "extra_resistance": self.port_extra_r[j],
+                    "port_area": self.port_area[j],
+                    "port_area_target": self.port_area_target[j],
+                    "port_area_step": self.port_area_step[j],
+                })
+            })
+            .collect();
+        let noise: Vec<Value> = self
+            .noise
+            .iter()
+            .map(|s| json!({ "src": s.src, "fwd": s.fwd, "bwd": s.bwd, "gain": s.gain, "hp": s.hp, "lp1": s.lp1, "lp2": s.lp2, "lp_coef": s.lp_coef, "hp_coef": s.hp_coef, "level": s.level }))
+            .collect();
+        let mut m = serde_json::Map::new();
+        m.insert("finalized".to_string(), json!(self.finalized));
+        m.insert("inv_t".to_string(), json!(self.inv_t));
+        m.insert("tube_specs".to_string(), json!(tube_specs));
+        m.insert("is_junction".to_string(), json!(self.is_junction));
+        m.insert("fixed".to_string(), json!(self.fixed));
+        m.insert("has_wall".to_string(), json!(self.has_wall));
+        m.insert("wall_m".to_string(), json!(self.wall_m));
+        m.insert("wall_r".to_string(), json!(self.wall_r));
+        m.insert("wall_k".to_string(), json!(self.wall_k));
+        m.insert("wall_perim".to_string(), json!(self.wall_perim));
+        m.insert("wall_rad".to_string(), json!(self.wall_rad));
+        m.insert("node_tube".to_string(), json!(self.node_tube));
+        m.insert("visc_f".to_string(), json!(self.visc_f));
+        m.insert("rad_of".to_string(), json!(self.rad_of));
+        m.insert("nbr_start".to_string(), json!(self.nbr_start));
+        m.insert("nbr_list".to_string(), json!(self.nbr_list));
+        m.insert("b_a".to_string(), json!(self.b_a));
+        m.insert("b_b".to_string(), json!(self.b_b));
+        m.insert("b_kind".to_string(), json!(self.b_kind));
+        m.insert("ports".to_string(), json!(ports));
+        m.insert("rad_nodes".to_string(), json!(self.rad_nodes));
+        m.insert("vol_lp_coef".to_string(), json!(self.vol_lp_coef));
+        m.insert("area_target".to_string(), json!(self.area_target));
+        m.insert("amin_target".to_string(), json!(self.amin_target));
+        m.insert("dx_target".to_string(), json!(self.dx_target));
+        m.insert("area_step".to_string(), json!(self.area_step));
+        m.insert("amin_step".to_string(), json!(self.amin_step));
+        m.insert("dx_step".to_string(), json!(self.dx_step));
+        m.insert("vol".to_string(), json!(self.vol));
+        m.insert("inv_a".to_string(), json!(self.inv_a));
+        m.insert("inv_amin".to_string(), json!(self.inv_amin));
+        m.insert("inv_lsum".to_string(), json!(self.inv_lsum));
+        m.insert("half_l".to_string(), json!(self.half_l));
+        m.insert("half_r".to_string(), json!(self.half_r));
+        m.insert("sqrt_a".to_string(), json!(self.sqrt_a));
+        m.insert("spill".to_string(), json!(self.spill));
+        m.insert("vol_src1".to_string(), json!(self.vol_src1));
+        m.insert("vol_src2".to_string(), json!(self.vol_src2));
+        m.insert("wall_v".to_string(), json!(self.wall_v));
+        m.insert("mom".to_string(), json!(self.mom));
+        m.insert("l_prev".to_string(), json!(self.l_prev));
+        m.insert("rad_ul".to_string(), json!(self.rad_ul));
+        m.insert("rad_l_prev".to_string(), json!(self.rad_l_prev));
+        m.insert("rad_prev_total".to_string(), json!(self.rad_prev_total));
+        m.insert("noise".to_string(), json!(noise));
+        m.insert("rng_state".to_string(), json!(self.rng.chimera_state()));
+        m.insert("pending_fixed".to_string(), json!(self.pending_fixed));
+        Value::Object(m)
+    }
+}
