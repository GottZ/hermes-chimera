+//! chimera export: read-only accessors for `sources::glottis` (child module).
+use super::ParametricGlottis;
+use serde_json::{Value, json};
+
+impl ParametricGlottis {
+    /// every private field of the glottis state
+    pub fn chimera_state(&self) -> Value {
+        let (dy, da, ds) = self.drift.chimera_state();
+        json!({
+            "phase": self.phase,
+            "cycle_amp": self.cycle_amp,
+            "cycle_period_scale": self.cycle_period_scale,
+            "cycle_index": self.cycle_index,
+            "chaos_x": self.chaos_x,
+            "vib_phase": self.vib_phase,
+            "rng_state": self.rng.chimera_state(),
+            "drift_y": dy,
+            "drift_a": da,
+            "drift_rng_state": ds,
+            "drift_value": self.drift_value,
+            "drift_counter": self.drift_counter,
+            "pitch_factor": self.pitch_factor,
+            "voicing": self.voicing,
+            "voicing_sm": self.voicing_sm,
+            "dp_sm": self.dp_sm,
+            "dp_coef": self.dp_coef,
+            "voice_coef": self.voice_coef,
+            "area": self.area,
+            "f0_now": self.f0_now,
+            "threshold": self.threshold,
+            "static_sm": self.static_sm,
+            "closure_sm": self.closure_sm,
+            "amp_sm": self.amp_sm,
+            "sm_coef": self.sm_coef,
+        })
+    }
+}
